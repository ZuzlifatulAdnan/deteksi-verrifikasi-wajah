# ============================================================
# Face Verification System — Environment Variables
# Salin file ini ke .env dan isi nilainya
# ============================================================

# --- MySQL (wajib) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=faceverify

# --- Supabase (opsional) ---
# Jika diisi, data disinkronkan ke Supabase cloud juga.
# Jika kosong, sistem hanya pakai MySQL lokal.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# --- CORS ---
# Daftar origin yang diizinkan, pisahkan dengan koma.
CORS_ORIGINS=http://localhost:8080,https://your-domain.com

# --- Server ---
HOST=0.0.0.0
PORT=8080
